# Copiar a backend/.env y completar con valores propios. No contiene secretos.
SECRET_KEY=
DB_NAME=agenda_db
DB_USER=agenda
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
ENVIRONMENT=L
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
CORS_ALLOW_CREDENTIALS=true
CSRF_TRUSTED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
SIGNING_KEY=
PORTAL_SYSTEM_CODE=agenda
PORTAL_DEFAULT_ROLE=CONSULTOR
PORTAL_AUTO_ENABLE_USERS=true

# Compatibilidad con credenciales anteriores: {"clave": "codigo_sistema"}
AGENDA_API_KEYS={}
# Formato: {"clave-secreta": {"sistema": "TRAMITES", "permisos": ["reservar", "consultar"]}}
EXPEDIENTES_API_KEYS={}
